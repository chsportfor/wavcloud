{
  "name": "wavcloud-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "WavCloud Windows music player",
  "author": "WavCloud",
  "main": "src/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "postinstall": "install-electron",
    "prepare:assets": "node tools/assets.mjs",
    "start": "node tools/launch.mjs",
    "test": "node --test test/*.test.cjs",
    "pack": "node tools/build.mjs --dir",
    "dist": "node tools/build.mjs"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.wavcloud.desktop",
    "productName": "WavCloud",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "asar": true,
    "electronLanguages": ["ko", "en-US"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico",
      "executableName": "WavCloud",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "WavCloud-PC-${version}-${arch}-nsis.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WavCloud",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "installerLanguages": ["ko_KR", "en_US"]
    },
    "portable": { "requestExecutionLevel": "user", "artifactName": "WavCloud-PC-${version}-${arch}-portable.${ext}" }
  }
}
